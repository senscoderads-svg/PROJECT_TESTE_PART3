          "rawQuery": true,
          "rawSql": "SELECT \n    $__time(time),\n    saldo as \"Saldo\",\n    wallet_address\nFROM (\n    SELECT \n        w.address as wallet_address,\n        h.balance as saldo,\n        h.collected_at as time\n    FROM wallet_history h\n    JOIN wallets w ON h.wallet_id = w.id\n    WHERE h.collected_at >= now() - interval '30 days'\n    ORDER BY h.collected_at ASC, w.address ASC\n) data\nORDER BY time ASC",
